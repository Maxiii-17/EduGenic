# Copy this file to .env and fill in your key
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Default gemini-3.6-flash. PDF used models/gemini-1.5-pro.
GEMINI_MODEL=gemini-3.6-flash

# Provider chain: auto = ollama -> gemini -> pollinations (keyless).
# Use "ollama" for private unlimited local AI, "pollinations" for keyless cloud.
AI_PROVIDER=auto
# Local model for Ollama (pull once: ollama pull qwen2.5:1.5b)
OLLAMA_MODEL=qwen2.5:1.5b
